 static inline float dot(float x, float y) {
     return x*y;
 }
diff --git a/ggml/src/ggml-metal/kernels/dequantize.h b/ggml/src/ggml-metal/kernels/dequantize.h
index 54e00faf6..60ff7b9aa 100644
--- a/ggml/src/ggml-metal/kernels/dequantize.h
+++ b/ggml/src/ggml-metal/kernels/dequantize.h
@@ -378,6 +378,44 @@ void dequantize_mxfp4_t4(device const block_mxfp4 * xb, short il, thread type4 &
     reg[3] = d * kvalues_mxfp4_f[(q2[4*il4 + 3] >> shr) & 0x0F];
 }
 
+// il = sub-block (16 values): low nibbles of its 8 bytes are values 0..7, high nibbles are values 8..15
+template <typename type4x4>
+void dequantize_nvfp4(device const block_nvfp4 * xb, short il, thread type4x4 & reg) {
+    device const uint8_t * q2 = xb->qs + 8*il;
+
+    const float d = ue4m3_to_fp32(xb->d[il]);
+
+    float4x4 reg_f;
+
+    for (int i = 0; i < 4; ++i) {
+        const short shr = i >= 2 ? 4 : 0;
+        const short j   = 4*(i%2);
+
+        reg_f[i][0] = d * kvalues_mxfp4_f[(q2[j + 0] >> shr) & 0x0F];
+        reg_f[i][1] = d * kvalues_mxfp4_f[(q2[j + 1] >> shr) & 0x0F];
+        reg_f[i][2] = d * kvalues_mxfp4_f[(q2[j + 2] >> shr) & 0x0F];
+        reg_f[i][3] = d * kvalues_mxfp4_f[(q2[j + 3] >> shr) & 0x0F];
+    }
+
+    reg = (type4x4) reg_f;
+}
+
+template <typename type4>
+void dequantize_nvfp4_t4(device const block_nvfp4 * xb, short il, thread type4 & reg) {
+    const short is = il/4;
+    const short ic = il%4;
+
+    device const uint8_t * q2 = xb->qs + 8*is + 4*(ic%2);
+
+    const float d = ue4m3_to_fp32(xb->d[is]);
+    const short shr = ic >= 2 ? 4 : 0;
+
+    reg[0] = d * kvalues_mxfp4_f[(q2[0] >> shr) & 0x0F];
+    reg[1] = d * kvalues_mxfp4_f[(q2[1] >> shr) & 0x0F];
+    reg[2] = d * kvalues_mxfp4_f[(q2[2] >> shr) & 0x0F];
+    reg[3] = d * kvalues_mxfp4_f[(q2[3] >> shr) & 0x0F];
+}
+
 template <typename type4x4>
 void dequantize_q2_K(device const block_q2_K *xb, short il, thread type4x4 & reg) {
     const float d = xb->d;
