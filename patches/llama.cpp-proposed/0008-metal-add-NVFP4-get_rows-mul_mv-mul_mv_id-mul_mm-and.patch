diff --git a/ggml/src/ggml-metal/kernels/common.h b/ggml/src/ggml-metal/kernels/common.h
index c4d674394..f8ad67d9b 100644
--- a/ggml/src/ggml-metal/kernels/common.h
+++ b/ggml/src/ggml-metal/kernels/common.h
@@ -68,6 +68,16 @@ static inline float e8m0_to_fp32(uint8_t x) {
     return as_type<float>(bits);
 }
 
+// 2x the CPU ggml_ue4m3_to_fp32 (that one pairs with doubled int8 E2M1 values) for all 256 byte values; bit 7 is ignored
+static inline float ue4m3_to_fp32(uint8_t x) {
+    const uint e = (x >> 3) & 0xF;
+    const uint m = x & 0x7;
+
+    const float v = e == 0 ? float(m) * 0x1p-9f : as_type<float>(((e + 120u) << 23) | (m << 20));
+
+    return (x == 0 || x == 0x7F) ? 0.0f : v;
+}
